<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - ServiceDesk AI' : 'Mesa de Ayuda TI con IA - Smart Service Desk' %></title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Custom Design Tokens (Enterprise Corporate Clean) -->
  <link rel="stylesheet" href="/css/design-tokens.css">
</head>
<body class="bg-light">

  <!-- Top Enterprise Navbar -->
  <header class="sd-navbar shadow-sm sticky-top">
    <div class="container-fluid d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <!-- Sidebar Toggle for Desktop and Mobile -->
        <button id="sd-sidebar-toggle" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" type="button" aria-label="Alternar Barra Lateral" title="Ocultar o mostrar barra lateral">
          <i class="bi bi-layout-sidebar-inset fs-6"></i>
        </button>

        <a href="/" class="text-decoration-none d-flex align-items-center">
          <span class="fw-bold text-dark fs-5">ServiceDesk<span class="text-primary">AI</span></span>
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-semibold" style="width: 32px; height: 32px; font-size: 0.8rem;">
            TI
          </div>
          <span class="d-none d-md-inline small fw-medium text-secondary">Especialista TI</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Persistent App Layout Wrapper -->
  <div class="sd-app-layout d-flex min-vh-100">
    <!-- Sidebar Navigation -->
    <%- include('sidebar') %>

    <!-- Main Content Area -->
    <div class="sd-main-wrapper flex-grow-1 d-flex flex-column bg-light overflow-auto">
