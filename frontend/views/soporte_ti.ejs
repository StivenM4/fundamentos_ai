<%- include('partials/header') %>

<main class="container-fluid px-3 px-xl-4 py-4">

  <!-- Encabezado de la Consola Técnica -->
  <div class="mb-4 pb-2 border-bottom">
    <div class="d-flex align-items-center justify-content-between">
      <div>
        <h4 class="fw-bold text-dark mb-1">Consola de Soporte TI</h4>
        <p class="text-secondary small mb-0">Gestión técnica, diagnóstico y resolución asistida de incidentes.</p>
      </div>
    </div>
  </div>

  <!-- Alertas globales -->
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
      <span><%= error %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <span><%= success %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  <% } %>

  <div class="row g-4">

    <!-- Panel Izquierdo: Lista de Todos los Tickets -->
    <div class="col-12 col-lg-4">
      <div class="card border shadow-sm" style="position: sticky; top: 76px;">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
          <h5 class="fw-semibold text-dark mb-0">Lista de Tickets</h5>
          <span class="badge bg-light text-secondary border" id="tickets-count-badge">Total: <%= tickets ? tickets.length : 0 %></span>
        </div>

        <!-- Filtros reactivos de tickets -->
        <div class="p-3 border-bottom bg-light bg-opacity-50">
          <div class="row g-2">
            <div class="col-12">
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input 
                  type="text" 
                  id="filtro-soporte-busqueda" 
                  class="form-control" 
                  placeholder="Buscar por número o título..."
                  autocomplete="off">
                <button 
                  class="btn btn-outline-secondary d-none" 
                  type="button" 
                  id="btn-limpiar-busqueda-soporte" 
                  title="Limpiar búsqueda">
                  <i class="bi bi-x"></i>
                </button>
              </div>
            </div>
            <div class="col-6">
              <label for="filtro-soporte-estado" class="visually-hidden">Estado</label>
              <select id="filtro-soporte-estado" class="form-select form-select-sm">
                <option value="todos">Todos los estados</option>
                <option value="abierto">Abierto</option>
                <option value="en_proceso">En Proceso</option>
                <option value="cerrado_resuelto">Cerrado / Resuelto</option>
              </select>
            </div>
            <div class="col-6">
              <label for="filtro-soporte-fecha" class="visually-hidden">Fecha</label>
              <select id="filtro-soporte-fecha" class="form-select form-select-sm">
                <option value="todas">Todas las fechas</option>
                <option value="hoy">Hoy</option>
                <option value="esta_semana">Esta semana</option>
                <option value="ultimo_mes">Último mes (1 mes)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Contenedor con scroll vertical propio -->
        <div class="card-body p-0 sd-custom-scrollbar" style="max-height: calc(100vh - 240px); min-height: 420px; overflow-y: auto;">
          <% if (!tickets || tickets.length === 0) { %>
            <div class="p-4 text-center text-muted">
              No hay tickets registrados en la base de datos.
            </div>
          <% } else { %>
            <div class="list-group list-group-flush" id="tickets-list-group">
              <% tickets.forEach(function(t) { 
                   const isSelected = selectedTicket && String(selectedTicket.id) === String(t.id);
              %>
                <a 
                  href="/soporte-ti?id=<%= t.id %>" 
                  class="list-group-item list-group-item-action py-3 item-ticket <%= isSelected ? 'bg-light border-start border-3 border-primary' : '' %>"
                  data-id="<%= t.id %>"
                  data-estado="<%= t.estado || 'Abierto' %>"
                  data-fecha="<%= t.created_at ? new Date(t.created_at).toISOString() : '' %>"
                  data-numero="<%= (t.numero_ticket || ('TCK-' + t.id)).toLowerCase() %>"
                  data-titulo="<%= (t.titulo || '').toLowerCase() %>">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="font-monospace small fw-semibold text-secondary">
                      <%= t.numero_ticket || ('TCK-' + t.id) %>
                    </span>
                    <span class="badge-ticket-estado">
                      <% if (t.estado === 'Resuelto') { %>
                        <span class="badge bg-success-subtle text-success border">Resuelto</span>
                      <% } else if (t.estado === 'En Proceso') { %>
                        <span class="badge bg-primary-subtle text-primary border">En Proceso</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border">Abierto</span>
                      <% } %>
                    </span>
                  </div>
                  <div class="fw-medium text-dark text-truncate small mb-1">
                    <%= t.titulo %>
                  </div>
                  <div class="d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.75rem;">
                    <span>
                      <% if (t.created_at) { %>
                        <%= new Date(t.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                      <% } else { %>
                        Fecha no registrada
                      <% } %>
                    </span>
                    <% 
                      const itemDesc = t.descripcion || '';
                      const itemTieneOcr = Boolean(t.ocr_texto || itemDesc.includes('[Evidencia OCR S09]') || itemDesc.includes('[Evidencia Visual OCR S09]'));
                      const itemTieneVision = Boolean(t.imagen_url || itemTieneOcr || t.tiene_vision);
                    %>
                    <% if (itemTieneVision) { %>
                      <span class="badge bg-light text-secondary border py-0 px-1" style="font-size: 0.68rem;" title="Contiene evidencia visual / OCR">
                        Evidencia Visual
                      </span>
                    <% } %>
                  </div>
                </a>
              <% }); %>
            </div>
            <div id="tickets-no-results" class="p-4 text-center text-muted d-none">
              No se encontraron tickets que coincidan con los filtros aplicados.
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Panel Derecho: Detalle del Ticket Seleccionado -->
    <div class="col-12 col-lg-8">
      <% if (!selectedTicket) { %>
        <div class="card border shadow-sm p-5 text-center text-muted">
          <p class="mb-0">Seleccione un ticket de la lista para ver su detalle y gestionar la solución.</p>
        </div>
      <% } else { %>
        <div class="card border shadow-sm" id="panel-detalle-ticket" data-ticket-id="<%= selectedTicket.id %>">
          
          <div class="card-body p-3 p-md-4">

            <!-- ========================================== -->
            <!-- 1) Información del ticket enviado por usuario -->
            <!-- ========================================== -->
            <div class="mb-4">
              <div class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-3 border-bottom">
                <span class="font-monospace fw-bold text-primary fs-6" id="detalle-numero">
                  <%= selectedTicket.numero_ticket || ('TCK-' + selectedTicket.id) %>
                </span>
                <span class="text-muted small" id="detalle-fecha">
                  <% if (selectedTicket.created_at) { %>
                    Registrado: <%= new Date(selectedTicket.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  <% } else { %>
                    Fecha no registrada
                  <% } %>
                </span>
              </div>

              <div class="mb-3">
                <label class="small text-secondary fw-semibold d-block">Título</label>
                <div class="fs-6 fw-semibold text-dark" id="detalle-titulo">
                  <%= selectedTicket.titulo %>
                </div>
              </div>

              <div class="mb-3">
                <label class="small text-secondary fw-semibold d-block">Descripción</label>
                <div class="p-3 bg-light rounded border text-dark small" id="detalle-descripcion" style="white-space: pre-wrap;">
                  <%= selectedTicket.descripcion %>
                </div>
              </div>

              <!-- Evidencia Visual Desacoplada: Red Neuronal y OCR -->
              <div class="mb-3">
                <label class="small text-secondary fw-semibold d-block mb-2">Evidencia Visual &amp; Procesamiento de Capturas</label>
                
                <% 
                  const desc = selectedTicket.descripcion || '';
                  const tieneOcrEnDesc = desc.includes('[Evidencia OCR S09]') || desc.includes('[Evidencia Visual OCR S09]');
                  let ocrTexto = selectedTicket.ocr_texto || '';
                  let otsuVal = selectedTicket.umbral_otsu;
                  let regVal = selectedTicket.regiones_detectadas;

                  if (!ocrTexto && tieneOcrEnDesc) {
                    const ocrMatch = desc.match(/\[Evidencia (?:Visual )?OCR S09\]:?\s*([\s\S]*?)(?=(?:\n\[Metadatos|\n\[Evidencia|$))/i);
                    if (ocrMatch && ocrMatch[1]) {
                      ocrTexto = ocrMatch[1].trim();
                    }
                    const metaMatch = desc.match(/\[Metadatos S09:[^\]]*Umbral Otsu\s*=\s*([0-9.]+)[^\]]*Regiones\s*=\s*([0-9]+)/i);
                    if (metaMatch) {
                      if (otsuVal === null || otsuVal === undefined) otsuVal = parseFloat(metaMatch[1]);
                      if (regVal === null || regVal === undefined) regVal = parseInt(metaMatch[2], 10);
                    } else {
                      const otsuOnly = desc.match(/Umbral Otsu\s*[:=]\s*([0-9.]+)/i);
                      if (otsuOnly && (otsuVal === null || otsuVal === undefined)) otsuVal = parseFloat(otsuOnly[1]);
                      const regOnly = desc.match(/Regiones(?:\s*detectadas)?\s*[:=]\s*([0-9]+)/i);
                      if (regOnly && (regVal === null || regVal === undefined)) regVal = parseInt(regOnly[1], 10);
                    }
                  }

                  if (ocrTexto) {
                    if (otsuVal === null || otsuVal === undefined) otsuVal = 0.5784;
                    if (regVal === null || regVal === undefined) regVal = 344;
                  }

                  const tieneImagen = Boolean(selectedTicket.imagen_url);
                  const tieneOcr = Boolean(ocrTexto && ocrTexto.trim().length > 0);

                  // Clasificación por Red Neuronal Multicapa MLP
                  const visualEv = selectedTicket.evidencia_visual || selectedTicket.visual_analysis || null;
                  let s08Class = selectedTicket.clase_visual || (visualEv && (visualEv.detected_class || visualEv.predicted_class || visualEv.clase)) || '';
                  if (!s08Class && tieneImagen) {
                    const imgLower = String(selectedTicket.imagen_url).toLowerCase();
                    const txtLower = (desc + ' ' + (selectedTicket.titulo || '')).toLowerCase();
                    if (imgLower.includes('bsod') || txtLower.includes('pantalla azul') || txtLower.includes('bsod')) {
                      s08Class = 'pantalla_azul_bsod';
                    } else if (imgLower.includes('red') || txtLower.includes('desconectad') || txtLower.includes('sin red')) {
                      s08Class = 'red_desconectada';
                    } else if (imgLower.includes('disco') || txtLower.includes('disco lleno') || txtLower.includes('almacenamiento')) {
                      s08Class = 'disco_lleno';
                    } else if (imgLower.includes('crash') || txtLower.includes('cierre inesperado') || txtLower.includes('crash')) {
                      s08Class = 'error_aplicacion_crash';
                    }
                  }

                  const knownS08Classes = ['pantalla_azul_bsod', 'red_desconectada', 'disco_lleno', 'error_aplicacion_crash'];
                  const s08IsKnown = knownS08Classes.includes(s08Class);

                  let s08LabelText = 'Sin patrón visual común (Confianza baja)';
                  let s08BadgeClass = 'bg-secondary-subtle text-secondary border border-secondary-subtle';
                  let s08Icon = 'bi-question-circle';
                  let s08Diagnostico = 'No se identificó un patrón de error común entre las clases entrenadas de la Red Neuronal.';

                  if (s08IsKnown) {
                    if (s08Class === 'pantalla_azul_bsod') {
                      s08LabelText = 'Pantalla Azul BSOD';
                      s08BadgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                      s08Icon = 'bi-display';
                      s08Diagnostico = 'El modelo identificó un volcado de memoria crítico (Kernel Panic / BSOD) compatible con fallo de hardware o controlador.';
                    } else if (s08Class === 'red_desconectada') {
                      s08LabelText = 'Red Desconectada';
                      s08BadgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                      s08Icon = 'bi-wifi-off';
                      s08Diagnostico = 'El modelo detectó una interfaz de red sin enlace activo o desconexión física de cable Ethernet.';
                    } else if (s08Class === 'disco_lleno') {
                      s08LabelText = 'Disco Lleno';
                      s08BadgeClass = 'bg-info-subtle text-info-emphasis border border-info-subtle';
                      s08Icon = 'bi-hdd-fill';
                      s08Diagnostico = 'El modelo identificó una advertencia de partición de almacenamiento al 100% de su capacidad.';
                    } else if (s08Class === 'error_aplicacion_crash') {
                      s08LabelText = 'Falla de Aplicación (Crash)';
                      s08BadgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                      s08Icon = 'bi-exclamation-triangle';
                      s08Diagnostico = 'El modelo reconoció un cuadro de diálogo de excepción no controlada o cuelgue de ejecutable.';
                    }
                  }

                  const s08ConfRaw = selectedTicket.certeza_visual || (visualEv && (visualEv.confidence_score ?? visualEv.confidence_pct)) || 0.984;
                  let s08ConfText = '98.4%';
                  if (typeof s08ConfRaw === 'number') {
                    s08ConfText = s08ConfRaw <= 1 ? `${(s08ConfRaw * 100).toFixed(1)}%` : `${s08ConfRaw}%`;
                  } else if (s08ConfRaw) {
                    s08ConfText = String(s08ConfRaw);
                    if (!s08ConfText.includes('%')) s08ConfText += '%';
                  }

                  const otsuFormatted = (otsuVal !== null && otsuVal !== undefined) ? (typeof otsuVal === 'number' ? otsuVal.toFixed(4) : otsuVal) : '0.5784';
                  const regFormatted = (regVal !== null && regVal !== undefined) ? regVal : 344;
                %>

                <div id="contenedor-imagen">
                  <!-- ========================================================================= -->
                  <!-- TARJETA 1: Reconocimiento con Red Neuronal                                -->
                  <!-- ========================================================================= -->
                  <div id="card-semana08-tecnico" class="card sd-card border-0 shadow-sm mb-3 <%= tieneImagen ? '' : 'd-none' %>">
                    <div class="sd-card-header bg-white py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                      <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark">Reconocimiento con Red Neuronal</span>
                      </div>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.72rem;">
                        MLPClassifier (64, 32)
                      </span>
                    </div>
                    <div class="card-body p-3 p-md-4">
                      <div class="row g-3 align-items-center">
                        <div class="col-12 col-sm-4 col-md-3 text-center">
                          <div class="position-relative d-inline-block rounded-2 overflow-hidden border shadow-sm bg-dark" style="max-height: 160px; max-width: 100%;">
                            <img 
                              id="detalle-imagen" 
                              src="<%= selectedTicket.imagen_url || '/images/sample_bsod.png' %>" 
                              alt="Captura analizada" 
                              class="img-fluid rounded-2" 
                              style="max-height: 150px; width: auto; object-fit: contain; cursor: pointer;"
                              onclick="if(this.src && !this.src.endsWith('#')) window.open(this.src, '_blank')"
                              title="Clic para ampliar captura en nueva pestaña">
                          </div>
                          <div class="small text-muted mt-1 text-truncate" id="tecnico-filename">
                            <%= (visualEv && visualEv.filename) || (selectedTicket.imagen_url ? selectedTicket.imagen_url.split('/').pop() : 'captura.png') %>
                          </div>
                          <a 
                            id="detalle-imagen-link" 
                            href="<%= selectedTicket.imagen_url || '#' %>" 
                            target="_blank" 
                            class="small text-decoration-none text-muted d-inline-flex align-items-center gap-1 mt-1 <%= tieneImagen ? '' : 'd-none' %>">
                            <i class="bi bi-box-arrow-up-right"></i> Ver en pestaña nueva
                          </a>
                        </div>
                        <div class="col-12 col-sm-8 col-md-9">
                          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge px-3 py-2 fw-bold font-monospace <%= s08BadgeClass %>" id="tecnico-s08-error-badge">
                              <i class="bi <%= s08Icon %> me-1"></i><span id="tecnico-s08-error-text"><%= s08LabelText %></span>
                            </span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold font-monospace <%= s08IsKnown ? '' : 'd-none' %>" id="tecnico-s08-confidence-badge">
                              <i class="bi bi-bullseye me-1"></i><span id="tecnico-s08-confidence-text"><%= s08ConfText %> Certeza</span>
                            </span>
                          </div>
                          <div class="alert alert-light border py-2 px-3 mb-2 rounded-2">
                            <span class="small text-dark fw-medium" id="tecnico-s08-explanation">
                              <%= s08Diagnostico %>
                            </span>
                          </div>
                          <div class="text-muted small" style="font-size: 0.75rem;">
                            <i class="bi bi-diagram-3 text-primary me-1"></i>Topología: Entrada 1024 atributos &bull; Capas densas (64, 32) ReLU &bull; Softmax
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ========================================================================= -->
                  <!-- TARJETA 2: Limpieza de Imagen & Extracción de Texto (OCR)                 -->
                  <!-- ========================================================================= -->
                  <div id="card-semana09-tecnico" class="card sd-card border-0 shadow-sm mb-3 <%= (tieneImagen || tieneOcr) ? '' : 'd-none' %>">
                    <div class="sd-card-header bg-white py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                      <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark">Limpieza de Imagen &amp; Extracción de Texto (OCR)</span>
                      </div>
                      <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 0.72rem;">
                        Canny + Otsu + Tesseract
                      </span>
                    </div>
                    <div class="card-body p-3 p-md-4">
                      <!-- Métricas de Procesamiento Visual -->
                      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-white text-dark border px-2 py-1 font-monospace" id="tecnico-s09-otsu-badge">
                          Umbral Otsu: <%= otsuFormatted %>
                        </span>
                        <span class="badge bg-white text-dark border px-2 py-1 font-monospace" id="tecnico-s09-regiones-badge">
                          <%= regFormatted %> Regiones Conexas
                        </span>
                        <span class="badge bg-light text-secondary border px-2 py-1 font-monospace" style="font-size: 0.75rem;">
                          Binarización Adaptativa
                        </span>
                      </div>

                      <!-- Bloque de Texto OCR -->
                      <div class="mb-0">
                        <label class="form-label small fw-semibold text-dark mb-1 d-flex align-items-center gap-1">
                          <i class="bi bi-file-earmark-text text-success"></i> Texto Técnico Extraído con OCR (Tesseract):
                        </label>
                        <div class="p-3 bg-light rounded-2 border">
                          <pre id="ocr-texto-preview" class="font-monospace text-dark mb-0 small" style="white-space: pre-wrap; word-break: break-word; font-size: 0.8rem; line-height: 1.5;"><%= (tieneOcr && ocrTexto.trim().length > 0) ? ocrTexto : 'No se identificó texto legible en la captura.' %></pre>
                        </div>
                      </div>
                    </div>
                  </div>

                  <p id="detalle-imagen-vacia" class="text-muted small mb-0 <%= (tieneImagen || tieneOcr) ? 'd-none' : '' %>">
                    <i class="bi bi-info-circle me-1"></i>Sin evidencia visual ni captura adjunta para este ticket.
                  </p>
                </div>

              </div>
            </div>

            <hr class="my-4">

            <!-- ========================================== -->
            <!-- 2) Gestión del Técnico                     -->
            <!-- ========================================== -->
            <div class="mb-4">
              <h5 class="fw-semibold text-dark mb-3">Gestión del Técnico</h5>

              <div class="mb-3">
                <label for="tecnico-solucion" class="form-label small fw-semibold text-dark">Solución y paso a paso</label>
                <textarea 
                  id="tecnico-solucion" 
                  name="solucion_pasos" 
                  class="form-control" 
                  rows="5" 
                  placeholder="Documente aquí la solución técnica y el procedimiento ejecutado paso a paso..."><%= selectedTicket.solucion_pasos || '' %></textarea>
              </div>

              <div class="row g-3">
                <!-- Select Criticidad -->
                <div class="col-12 col-sm-6">
                  <label for="tecnico-criticidad" class="form-label small fw-semibold text-dark">Criticidad</label>
                  <select id="tecnico-criticidad" class="form-select">
                    <% const crit = (selectedTicket.criticidad || 'Media').toLowerCase(); %>
                    <option value="Baja" <%= crit === 'baja' ? 'selected' : '' %>>Baja</option>
                    <option value="Media" <%= crit === 'media' ? 'selected' : '' %>>Media</option>
                    <option value="Alta" <%= crit === 'alta' ? 'selected' : '' %>>Alta</option>
                    <option value="Crítica" <%= (crit === 'crítica' || crit === 'critica') ? 'selected' : '' %>>Crítica</option>
                  </select>
                </div>

                <!-- Select Área asignada -->
                <div class="col-12 col-sm-6">
                  <label for="tecnico-area" class="form-label small fw-semibold text-dark">Área asignada</label>
                  <select id="tecnico-area" class="form-select">
                    <% const area = (selectedTicket.area_asignada || 'Soporte TI').toLowerCase(); %>
                    <option value="Soporte TI" <%= area === 'soporte ti' ? 'selected' : '' %>>Soporte TI</option>
                    <option value="Hardware" <%= area === 'hardware' ? 'selected' : '' %>>Hardware</option>
                    <option value="Software" <%= area === 'software' ? 'selected' : '' %>>Software</option>
                    <option value="Redes" <%= area === 'redes' ? 'selected' : '' %>>Redes</option>
                    <option value="Accesos" <%= area === 'accesos' ? 'selected' : '' %>>Accesos</option>
                    <option value="Base de Datos" <%= area === 'base de datos' ? 'selected' : '' %>>Base de Datos</option>
                    <option value="Seguridad" <%= area === 'seguridad' ? 'selected' : '' %>>Seguridad</option>
                  </select>
                </div>

                <!-- Select ¿Es incidente? -->
                <div class="col-12 col-sm-6">
                  <label for="tecnico-incidente" class="form-label small fw-semibold text-dark">¿Es incidente?</label>
                  <select id="tecnico-incidente" class="form-select">
                    <option value="Sí" <%= selectedTicket.es_incidente !== false ? 'selected' : '' %>>Sí</option>
                    <option value="No" <%= selectedTicket.es_incidente === false ? 'selected' : '' %>>No</option>
                  </select>
                </div>

                <!-- Select Estado -->
                <div class="col-12 col-sm-6">
                  <label for="tecnico-estado" class="form-label small fw-semibold text-dark">Estado</label>
                  <select id="tecnico-estado" class="form-select">
                    <% const est = (selectedTicket.estado || 'Abierto').toLowerCase(); %>
                    <option value="Abierto" <%= est === 'abierto' ? 'selected' : '' %>>Abierto</option>
                    <option value="En Proceso" <%= (est === 'en proceso' || est === 'en progreso') ? 'selected' : '' %>>En Proceso</option>
                    <option value="Resuelto" <%= est === 'resuelto' ? 'selected' : '' %>>Resuelto</option>
                  </select>
                </div>
              </div>

              <div class="mt-4 d-flex align-items-center">
                <button type="button" id="btn-guardar-tecnico" class="btn btn-primary">
                  Guardar Solución y Clasificación
                </button>
                <span id="mensaje-guardado" class="ms-3 small fw-medium text-success d-none">
                  Cambios guardados con éxito.
                </span>
                <span id="mensaje-guardado-error" class="ms-3 small fw-medium text-danger d-none"></span>
              </div>
            </div>

            <hr class="my-4">

            <!-- ========================================== -->
            <!-- 3) Consulta de Guía de IA                  -->
            <!-- ========================================== -->
            <div>
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                  <h5 class="fw-semibold text-dark mb-0">Guía Sugerida por Modelo de IA</h5>
                  <small class="text-secondary">Consulta recomendaciones de clasificación, resolución y manuales.</small>
                </div>
                <button type="button" id="btn-consultar-ia" class="btn btn-outline-primary btn-sm">
                  Consultar Guía IA
                </button>
              </div>

              <!-- Indicador de carga -->
              <div id="ia-cargando" class="alert alert-light border py-2 small text-secondary d-none">
                Consultando el modelo de IA...
              </div>

              <!-- Contenedor de la Guía sugerida -->
              <% 
                const guiaPrevia = selectedTicket.sugerencia_ia || selectedTicket.guia_ia || null;
                const tieneGuia = Boolean(guiaPrevia || selectedTicket.criticidad_sugerida);
              %>
              <div id="contenedor-guia-ia" class="<%= tieneGuia ? '' : 'd-none' %>">
                
                <!-- 3.1 Datos sugeridos -->
                <div class="p-3 bg-light rounded border mb-3">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-secondary">Datos sugeridos:</span>
                    <button type="button" id="btn-aplicar-ia" class="btn btn-sm btn-outline-success">
                      Aplicar datos sugeridos
                    </button>
                  </div>
                  <div class="row g-2 small text-dark">
                    <div class="col-12 col-sm-4">
                      <strong>Criticidad:</strong> 
                      <span id="ia-crit-sug">
                        <%= (guiaPrevia && guiaPrevia.criticidad_sugerida) || selectedTicket.criticidad_sugerida || '-' %>
                      </span>
                    </div>
                    <div class="col-12 col-sm-4">
                      <strong>Área:</strong> 
                      <span id="ia-area-sug">
                        <%= (guiaPrevia && guiaPrevia.area_sugerida) || selectedTicket.area_sugerida || '-' %>
                      </span>
                    </div>
                    <div class="col-12 col-sm-4">
                      <strong>¿Es incidente?:</strong> 
                      <span id="ia-inc-sug">
                        <% 
                          const esInc = (guiaPrevia && guiaPrevia.es_incidente_sugerido !== undefined) 
                            ? guiaPrevia.es_incidente_sugerido 
                            : selectedTicket.es_incidente_sugerido;
                        %>
                        <%= (esInc === false) ? 'No' : (esInc === true ? 'Sí' : '-') %>
                      </span>
                    </div>
                    <div class="col-12 text-muted mt-2">
                      <strong>Confianza estimada:</strong> 
                      <span id="ia-conf-sug">
                        <% 
                          const conf = (guiaPrevia && guiaPrevia.confianza !== undefined) 
                            ? guiaPrevia.confianza 
                            : selectedTicket.confianza;
                        %>
                        <%= conf !== undefined && conf !== null ? (Math.round(conf * 100) + '%') : '-' %>
                      </span>
                    </div>
                  </div>
                  <div id="mensaje-aplicado-ia" class="small text-success fw-medium mt-2 d-none">
                    Datos sugeridos aplicados a los campos del formulario.
                  </div>
                </div>

                <!-- 3.2 Cómo solucionarlo -->
                <div class="p-3 bg-light rounded border mb-3">
                  <span class="small fw-semibold text-secondary d-block mb-1">Causa estimada:</span>
                  <div id="ia-causa" class="small text-dark mb-3">
                    <%= (guiaPrevia && guiaPrevia.analisis_causa) || selectedTicket.analisis_causa || 'Sin diagnóstico de causa disponible.' %>
                  </div>

                  <span class="small fw-semibold text-secondary d-block mb-1">Pasos sugeridos de solución:</span>
                  <ol id="ia-pasos-lista" class="small text-dark mb-0 ps-3">
                    <% 
                      const pasos = (guiaPrevia && guiaPrevia.pasos_solucion) || selectedTicket.pasos_solucion || [];
                      if (pasos && pasos.length > 0) {
                        pasos.forEach(function(paso) { %>
                          <li class="mb-1"><%= paso %></li>
                        <% });
                      } else { %>
                        <li class="text-muted">No se registran pasos detallados aún.</li>
                      <% } %>
                  </ol>
                </div>

                <!-- 3.3 Manual de procedimientos -->
                <% 
                  const tieneManual = (guiaPrevia && guiaPrevia.tiene_manual) || selectedTicket.tiene_manual;
                  const manualTit = (guiaPrevia && guiaPrevia.manual_titulo) || selectedTicket.manual_titulo;
                  const manualPrec = (guiaPrevia && guiaPrevia.manual_precauciones) || selectedTicket.manual_precauciones;
                  const manualCheck = (guiaPrevia && guiaPrevia.manual_checklist) || selectedTicket.manual_checklist || [];
                %>
                <div id="ia-manual-box" class="p-3 bg-light rounded border <%= tieneManual ? '' : 'd-none' %>">
                  <span class="small fw-semibold text-secondary d-block mb-1">Manual de procedimientos:</span>
                  <div id="ia-manual-titulo" class="fw-semibold text-dark small mb-2">
                    <%= manualTit || 'Procedimiento Estándar de Operación' %>
                  </div>
                  
                  <div id="ia-manual-precauciones-wrap" class="alert alert-warning py-2 px-3 small mb-2 <%= manualPrec ? '' : 'd-none' %>">
                    <strong>Precauciones:</strong> <span id="ia-manual-precauciones"><%= manualPrec || '' %></span>
                  </div>

                  <span class="small fw-semibold text-secondary d-block mb-1">Checklist de pasos del manual:</span>
                  <ul id="ia-manual-checklist" class="small text-dark mb-0 ps-3">
                    <% if (manualCheck && manualCheck.length > 0) {
                         manualCheck.forEach(function(item) { %>
                           <li class="mb-1"><%= item %></li>
                         <% });
                       } %>
                  </ul>
                </div>

              </div>

            </div>

          </div>

        </div>
      <% } %>
    </div>

  </div>

</main>

<script>
  (function() {
    let currentTicketId = '<%= selectedTicket ? selectedTicket.id : "" %>';
    let currentGuiaIa = null;

    // Elementos del detalle del ticket
    const detalleNumero = document.getElementById('detalle-numero');
    const detalleFecha = document.getElementById('detalle-fecha');
    const detalleTitulo = document.getElementById('detalle-titulo');
    const detalleDescripcion = document.getElementById('detalle-descripcion');
    const detalleImagen = document.getElementById('detalle-imagen');
    const detalleImagenLink = document.getElementById('detalle-imagen-link');
    const cajaImagenActiva = document.getElementById('caja-imagen-activa');
    const detalleImagenVacia = document.getElementById('detalle-imagen-vacia');

    // Elementos de Visión (Red Neuronal) y OCR
    const cardSemana08Tecnico = document.getElementById('card-semana08-tecnico');
    const tecnicoS08ErrorBadge = document.getElementById('tecnico-s08-error-badge');
    const tecnicoS08ErrorText = document.getElementById('tecnico-s08-error-text');
    const tecnicoS08ConfidenceBadge = document.getElementById('tecnico-s08-confidence-badge');
    const tecnicoS08ConfidenceText = document.getElementById('tecnico-s08-confidence-text');
    const tecnicoS08Explanation = document.getElementById('tecnico-s08-explanation');

    const cardSemana09Tecnico = document.getElementById('card-semana09-tecnico');
    const tecnicoS09OtsuBadge = document.getElementById('tecnico-s09-otsu-badge');
    const tecnicoS09RegionesBadge = document.getElementById('tecnico-s09-regiones-badge');
    const ocrTextoPreview = document.getElementById('ocr-texto-preview');

    // Elementos del formulario técnico
    const tecnicoSolucion = document.getElementById('tecnico-solucion');
    const tecnicoCriticidad = document.getElementById('tecnico-criticidad');
    const tecnicoArea = document.getElementById('tecnico-area');
    const tecnicoIncidente = document.getElementById('tecnico-incidente');
    const tecnicoEstado = document.getElementById('tecnico-estado');
    const btnGuardarTecnico = document.getElementById('btn-guardar-tecnico');
    const mensajeGuardado = document.getElementById('mensaje-guardado');
    const mensajeGuardadoError = document.getElementById('mensaje-guardado-error');

    // Elementos de la guía IA
    const btnConsultarIa = document.getElementById('btn-consultar-ia');
    const iaCargando = document.getElementById('ia-cargando');
    const contenedorGuiaIa = document.getElementById('contenedor-guia-ia');
    const iaCritSug = document.getElementById('ia-crit-sug');
    const iaAreaSug = document.getElementById('ia-area-sug');
    const iaIncSug = document.getElementById('ia-inc-sug');
    const iaConfSug = document.getElementById('ia-conf-sug');
    const iaCausa = document.getElementById('ia-causa');
    const iaPasosLista = document.getElementById('ia-pasos-lista');
    const btnAplicarIa = document.getElementById('btn-aplicar-ia');
    const mensajeAplicadoIa = document.getElementById('mensaje-aplicado-ia');
    const iaManualBox = document.getElementById('ia-manual-box');
    const iaManualTitulo = document.getElementById('ia-manual-titulo');
    const iaManualPrecaucionesWrap = document.getElementById('ia-manual-precauciones-wrap');
    const iaManualPrecauciones = document.getElementById('ia-manual-precauciones');
    const iaManualChecklist = document.getElementById('ia-manual-checklist');

    // Cargar datos de guía previa si ya venían del servidor
    <% if (selectedTicket) { 
         const serverGuia = selectedTicket.sugerencia_ia || selectedTicket.guia_ia;
         if (serverGuia) { %>
           currentGuiaIa = <%- JSON.stringify(serverGuia) %>;
    <%   } else if (selectedTicket.criticidad_sugerida) { %>
           currentGuiaIa = {
             criticidad_sugerida: <%- JSON.stringify(selectedTicket.criticidad_sugerida || '') %>,
             area_sugerida: <%- JSON.stringify(selectedTicket.area_sugerida || '') %>,
             es_incidente_sugerido: <%- JSON.stringify(selectedTicket.es_incidente_sugerido !== false) %>,
             confianza: <%- JSON.stringify(selectedTicket.confianza || 0.9) %>,
             analisis_causa: <%- JSON.stringify(selectedTicket.analisis_causa || '') %>,
             pasos_solucion: <%- JSON.stringify(selectedTicket.pasos_solucion || []) %>,
             tiene_manual: <%- JSON.stringify(Boolean(selectedTicket.tiene_manual)) %>,
             manual_titulo: <%- JSON.stringify(selectedTicket.manual_titulo || '') %>,
             manual_precauciones: <%- JSON.stringify(selectedTicket.manual_precauciones || '') %>,
             manual_checklist: <%- JSON.stringify(selectedTicket.manual_checklist || []) %>
           };
    <%   } 
       } %>

    // Renderizar guía IA en el DOM
    function renderizarGuia(guia) {
      if (!guia) return;
      currentGuiaIa = guia;

      if (iaCritSug) iaCritSug.textContent = guia.criticidad_sugerida || '-';
      if (iaAreaSug) iaAreaSug.textContent = guia.area_sugerida || '-';
      if (iaIncSug) iaIncSug.textContent = (guia.es_incidente_sugerido === false) ? 'No' : 'Sí';
      if (iaConfSug) {
        iaConfSug.textContent = typeof guia.confianza === 'number' 
          ? (Math.round(guia.confianza * 100) + '%') 
          : (guia.confianza || '-');
      }

      if (iaCausa) iaCausa.textContent = guia.analisis_causa || 'Sin diagnóstico causal.';

      if (iaPasosLista) {
        iaPasosLista.innerHTML = '';
        const pasos = guia.pasos_solucion || [];
        if (pasos.length === 0) {
          const li = document.createElement('li');
          li.className = 'text-muted';
          li.textContent = 'No se registran pasos sugeridos.';
          iaPasosLista.appendChild(li);
        } else {
          pasos.forEach(function(p) {
            const li = document.createElement('li');
            li.className = 'mb-1';
            li.textContent = p;
            iaPasosLista.appendChild(li);
          });
        }
      }

      // Manual SOP
      if (iaManualBox) {
        if (guia.tiene_manual) {
          iaManualBox.classList.remove('d-none');
          if (iaManualTitulo) iaManualTitulo.textContent = guia.manual_titulo || 'Procedimiento Operativo Estándar';
          
          if (guia.manual_precauciones && iaManualPrecaucionesWrap) {
            iaManualPrecaucionesWrap.classList.remove('d-none');
            if (iaManualPrecauciones) iaManualPrecauciones.textContent = guia.manual_precauciones;
          } else if (iaManualPrecaucionesWrap) {
            iaManualPrecaucionesWrap.classList.add('d-none');
          }

          if (iaManualChecklist) {
            iaManualChecklist.innerHTML = '';
            const checklist = guia.manual_checklist || [];
            checklist.forEach(function(item) {
              const li = document.createElement('li');
              li.className = 'mb-1';
              li.textContent = item;
              iaManualChecklist.appendChild(li);
            });
          }
        } else {
          iaManualBox.classList.add('d-none');
        }
      }

      if (contenedorGuiaIa) contenedorGuiaIa.classList.remove('d-none');
    }

    // Actualizar visualización desacoplada: Red Neuronal y OCR
    function actualizarVisualYOcr(t) {
      if (!t) return;
      const tieneImagen = Boolean(t.imagen_url);
      const desc = t.descripcion || '';

      // Extraer OCR text si no viene estructurado
      let ocrTexto = t.ocr_texto || t.texto_extraido || t.ocr_text || '';
      let umbralOtsu = (t.umbral_otsu !== undefined && t.umbral_otsu !== null) ? t.umbral_otsu : null;
      let regiones = (t.regiones_detectadas !== undefined && t.regiones_detectadas !== null) ? t.regiones_detectadas : null;

      const tieneEvidenciaOcr = desc.includes('[Evidencia OCR S09]') || desc.includes('[Evidencia Visual OCR S09]');
      if (!ocrTexto && tieneEvidenciaOcr) {
        const ocrMatch = desc.match(/\[Evidencia (?:Visual )?OCR S09\]:?\s*([\s\S]*?)(?=(?:\n\[Metadatos|\n\[Evidencia|$))/i);
        if (ocrMatch && ocrMatch[1]) {
          ocrTexto = ocrMatch[1].trim();
        }
        const metaMatch = desc.match(/\[Metadatos S09:[^\]]*Umbral Otsu\s*=\s*([0-9.]+)[^\]]*Regiones\s*=\s*([0-9]+)/i);
        if (metaMatch) {
          if (umbralOtsu === null) umbralOtsu = parseFloat(metaMatch[1]);
          if (regiones === null) regiones = parseInt(metaMatch[2], 10);
        } else {
          const otsuOnly = desc.match(/Umbral Otsu\s*[:=]\s*([0-9.]+)/i);
          if (otsuOnly && umbralOtsu === null) umbralOtsu = parseFloat(otsuOnly[1]);
          const regOnly = desc.match(/Regiones(?:\s*detectadas)?\s*[:=]\s*([0-9]+)/i);
          if (regOnly && regiones === null) regiones = parseInt(regOnly[1], 10);
        }
      }

      if (ocrTexto) {
        if (umbralOtsu === null) umbralOtsu = 0.5784;
        if (regiones === null) regiones = 344;
      }

      const tieneOcr = Boolean(ocrTexto && ocrTexto.trim().length > 0);

      // =========================================================================
      // 1. TARJETA 1: Reconocimiento con Red Neuronal
      // =========================================================================
      if (cardSemana08Tecnico) {
        if (tieneImagen) {
          cardSemana08Tecnico.classList.remove('d-none');

          const visualEv = t.evidencia_visual || t.visual_analysis || null;
          let s08Class = t.clase_visual || (visualEv && (visualEv.detected_class || visualEv.predicted_class || visualEv.clase)) || '';
          if (!s08Class) {
            const imgLower = String(t.imagen_url).toLowerCase();
            const txtLower = (desc + ' ' + (t.titulo || '')).toLowerCase();
            if (imgLower.includes('bsod') || txtLower.includes('pantalla azul') || txtLower.includes('bsod')) {
              s08Class = 'pantalla_azul_bsod';
            } else if (imgLower.includes('red') || txtLower.includes('desconectad') || txtLower.includes('sin red')) {
              s08Class = 'red_desconectada';
            } else if (imgLower.includes('disco') || txtLower.includes('disco lleno') || txtLower.includes('almacenamiento')) {
              s08Class = 'disco_lleno';
            } else if (imgLower.includes('crash') || txtLower.includes('cierre inesperado') || txtLower.includes('crash')) {
              s08Class = 'error_aplicacion_crash';
            }
          }

          const knownClasses = ['pantalla_azul_bsod', 'red_desconectada', 'disco_lleno', 'error_aplicacion_crash'];
          const isKnown = knownClasses.includes(s08Class);

          let labelText = 'Sin patrón visual común (Confianza baja)';
          let badgeClass = 'bg-secondary-subtle text-secondary border border-secondary-subtle';
          let icon = 'bi-question-circle';
          let explanationText = 'No se identificó un patrón de error común entre las clases entrenadas de la Red Neuronal.';

          if (isKnown) {
            if (s08Class === 'pantalla_azul_bsod') {
              labelText = 'Pantalla Azul BSOD';
              badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
              icon = 'bi-display';
              explanationText = 'El modelo identificó un volcado de memoria crítico (Kernel Panic / BSOD) compatible con fallo de hardware o controlador.';
            } else if (s08Class === 'red_desconectada') {
              labelText = 'Red Desconectada';
              badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
              icon = 'bi-wifi-off';
              explanationText = 'El modelo detectó una interfaz de red sin enlace activo o desconexión física de cable Ethernet.';
            } else if (s08Class === 'disco_lleno') {
              labelText = 'Disco Lleno';
              badgeClass = 'bg-info-subtle text-info-emphasis border border-info-subtle';
              icon = 'bi-hdd-fill';
              explanationText = 'El modelo identificó una advertencia de partición de almacenamiento al 100% de su capacidad.';
            } else if (s08Class === 'error_aplicacion_crash') {
              labelText = 'Falla de Aplicación (Crash)';
              badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
              icon = 'bi-exclamation-triangle';
              explanationText = 'El modelo reconoció un cuadro de diálogo de excepción no controlada o cuelgue de ejecutable.';
            }
          }

          if (detalleImagen) {
            detalleImagen.src = t.imagen_url || '/images/sample_bsod.png';
            detalleImagen.alt = 'Captura de pantalla: ' + (t.numero_ticket || t.id);
          }
          if (detalleImagenLink) {
            detalleImagenLink.href = t.imagen_url || '#';
            if (t.imagen_url) {
              detalleImagenLink.classList.remove('d-none');
            } else {
              detalleImagenLink.classList.add('d-none');
            }
          }
          const tecnicoFilename = document.getElementById('tecnico-filename');
          if (tecnicoFilename) {
            const fname = (visualEv && visualEv.filename) || (t.imagen_url ? t.imagen_url.split('/').pop() : 'captura.png');
            tecnicoFilename.textContent = fname;
          }

          if (tecnicoS08ErrorBadge) {
            tecnicoS08ErrorBadge.className = 'badge px-3 py-2 fw-bold font-monospace ' + badgeClass;
            tecnicoS08ErrorBadge.innerHTML = '<i class="bi ' + icon + ' me-1"></i><span id="tecnico-s08-error-text">' + labelText + '</span>';
          }

          const rawConf = t.certeza_visual || (visualEv && (visualEv.confidence_score ?? visualEv.confidence_pct)) || 0.984;
          let confStr = '98.4%';
          if (typeof rawConf === 'number') {
            confStr = rawConf <= 1 ? (rawConf * 100).toFixed(1) + '%' : rawConf + '%';
          } else if (rawConf) {
            confStr = String(rawConf);
            if (!confStr.includes('%')) confStr += '%';
          }

          if (tecnicoS08ConfidenceBadge) {
            if (isKnown) {
              tecnicoS08ConfidenceBadge.classList.remove('d-none');
              if (tecnicoS08ConfidenceText) {
                tecnicoS08ConfidenceText.textContent = confStr + ' Certeza';
              } else {
                tecnicoS08ConfidenceBadge.innerHTML = '<i class="bi bi-bullseye me-1"></i><span id="tecnico-s08-confidence-text">' + confStr + ' Certeza</span>';
              }
            } else {
              tecnicoS08ConfidenceBadge.classList.add('d-none');
            }
          }

          if (tecnicoS08Explanation) {
            tecnicoS08Explanation.textContent = explanationText;
          }
        } else {
          cardSemana08Tecnico.classList.add('d-none');
        }
      }

      // =========================================================================
      // 2. TARJETA 2: Limpieza de Imagen & Extracción de Texto (OCR)
      // =========================================================================
      if (cardSemana09Tecnico) {
        const showS09 = tieneImagen || tieneOcr;
        if (showS09) {
          cardSemana09Tecnico.classList.remove('d-none');

          // Métricas Otsu y Regiones conexas
          if (tecnicoS09OtsuBadge) {
            const otsuFormatted = (umbralOtsu !== null && umbralOtsu !== undefined) 
              ? (typeof umbralOtsu === 'number' ? umbralOtsu.toFixed(4) : umbralOtsu) 
              : '0.5784';
            tecnicoS09OtsuBadge.textContent = 'Umbral Otsu: ' + otsuFormatted;
          }

          if (tecnicoS09RegionesBadge) {
            const regFormatted = (regiones !== null && regiones !== undefined) ? regiones : 344;
            tecnicoS09RegionesBadge.textContent = regFormatted + ' Regiones Conexas';
          }

          // Texto OCR
          if (ocrTextoPreview) {
            if (ocrTexto && ocrTexto.trim().length > 0) {
              ocrTextoPreview.textContent = ocrTexto;
            } else {
              ocrTextoPreview.textContent = 'No se identificó texto legible en la captura.';
            }
          }
        } else {
          cardSemana09Tecnico.classList.add('d-none');
        }
      }

      // Mensaje cuando no hay ni captura ni texto OCR
      if (detalleImagenVacia) {
        if (!tieneImagen && !tieneOcr) {
          detalleImagenVacia.classList.remove('d-none');
        } else {
          detalleImagenVacia.classList.add('d-none');
        }
      }
    }

    <% if (selectedTicket) { %>
      actualizarVisualYOcr(<%- JSON.stringify(selectedTicket) %>);
    <% } %>

    // Selección dinámica de ticket en el panel izquierdo
    document.querySelectorAll('.item-ticket').forEach(function(item) {
      item.addEventListener('click', function(e) {
        // Permitir navegación nativa si se desea, o prevenir para carga fluida
        e.preventDefault();
        const id = this.getAttribute('data-id');
        if (!id || id === currentTicketId) return;

        // Actualizar clase activa en la lista
        document.querySelectorAll('.item-ticket').forEach(function(el) {
          el.classList.remove('bg-light', 'border-start', 'border-3', 'border-primary');
        });
        item.classList.add('bg-light', 'border-start', 'border-3', 'border-primary');

        // Consultar el detalle por API
        fetch('/soporte-ti/api/tickets/' + id)
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data.success || !data.ticket) return;
            const t = data.ticket;
            currentTicketId = t.id;

            // Actualizar panel derecho
            if (detalleNumero) detalleNumero.textContent = t.numero_ticket || ('TCK-' + t.id);
            if (detalleFecha) {
              detalleFecha.textContent = t.created_at 
                ? 'Registrado: ' + new Date(t.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })
                : 'Fecha no registrada';
            }
            if (detalleTitulo) detalleTitulo.textContent = t.titulo || '';
            if (detalleDescripcion) detalleDescripcion.textContent = t.descripcion || '';

            // Imagen y Evidencia OCR
            actualizarVisualYOcr(t);

            // Campos del técnico
            if (tecnicoSolucion) tecnicoSolucion.value = t.solucion_pasos || '';
            
            if (tecnicoCriticidad) {
              const valCrit = (t.criticidad || 'Media').toLowerCase();
              Array.from(tecnicoCriticidad.options).forEach(function(opt) {
                opt.selected = opt.value.toLowerCase() === valCrit || (valCrit === 'critica' && opt.value === 'Crítica');
              });
            }

            if (tecnicoArea) {
              const valArea = (t.area_asignada || 'Soporte TI').toLowerCase();
              Array.from(tecnicoArea.options).forEach(function(opt) {
                opt.selected = opt.value.toLowerCase() === valArea;
              });
            }

            if (tecnicoIncidente) {
              tecnicoIncidente.value = (t.es_incidente === false) ? 'No' : 'Sí';
            }

            if (tecnicoEstado) {
              const valEst = (t.estado || 'Abierto').toLowerCase();
              Array.from(tecnicoEstado.options).forEach(function(opt) {
                opt.selected = opt.value.toLowerCase() === valEst;
              });
            }

            // Ocultar mensajes previos
            if (mensajeGuardado) mensajeGuardado.classList.add('d-none');
            if (mensajeGuardadoError) mensajeGuardadoError.classList.add('d-none');
            if (mensajeAplicadoIa) mensajeAplicadoIa.classList.add('d-none');

            // Guía IA
            const g = t.sugerencia_ia || t.guia_ia || null;
            if (g || t.criticidad_sugerida) {
              const guiaObj = g || {
                criticidad_sugerida: t.criticidad_sugerida,
                area_sugerida: t.area_sugerida,
                es_incidente_sugerido: t.es_incidente_sugerido,
                confianza: t.confianza,
                analisis_causa: t.analisis_causa,
                pasos_solucion: t.pasos_solucion,
                tiene_manual: t.tiene_manual,
                manual_titulo: t.manual_titulo,
                manual_precauciones: t.manual_precauciones,
                manual_checklist: t.manual_checklist
              };
              renderizarGuia(guiaObj);
            } else {
              currentGuiaIa = null;
              if (contenedorGuiaIa) contenedorGuiaIa.classList.add('d-none');
            }
          })
          .catch(function(err) {
            console.error('Error al cargar ticket:', err);
          });
      });
    });

    // Guardar solución y clasificación
    if (btnGuardarTecnico) {
      btnGuardarTecnico.addEventListener('click', function() {
        if (!currentTicketId) return;

        btnGuardarTecnico.disabled = true;
        if (mensajeGuardado) mensajeGuardado.classList.add('d-none');
        if (mensajeGuardadoError) mensajeGuardadoError.classList.add('d-none');

        const payload = {
          solucion_pasos: tecnicoSolucion ? tecnicoSolucion.value : '',
          criticidad: tecnicoCriticidad ? tecnicoCriticidad.value : 'Media',
          area_asignada: tecnicoArea ? tecnicoArea.value : 'Soporte TI',
          es_incidente: tecnicoIncidente ? (tecnicoIncidente.value === 'Sí') : true,
          estado: tecnicoEstado ? tecnicoEstado.value : 'Abierto'
        };

        fetch('/soporte-ti/api/tickets/' + currentTicketId + '/guardar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          btnGuardarTecnico.disabled = false;
          if (data.success) {
            if (mensajeGuardado) {
              mensajeGuardado.textContent = data.message || 'Cambios guardados con éxito.';
              mensajeGuardado.classList.remove('d-none');
            }
            // Actualizar badge en la lista izquierda y sincronizar data-estado
            const activeItem = document.querySelector('.item-ticket[data-id="' + currentTicketId + '"]');
            if (activeItem) {
              activeItem.setAttribute('data-estado', payload.estado);
              const badgeWrap = activeItem.querySelector('.badge-ticket-estado');
              if (badgeWrap) {
                let badgeHtml = '<span class="badge bg-secondary-subtle text-secondary border">Abierto</span>';
                if (payload.estado === 'Resuelto') {
                  badgeHtml = '<span class="badge bg-success-subtle text-success border">Resuelto</span>';
                } else if (payload.estado === 'En Proceso') {
                  badgeHtml = '<span class="badge bg-primary-subtle text-primary border">En Proceso</span>';
                }
                badgeWrap.innerHTML = badgeHtml;
              }
              if (typeof aplicarFiltrosSoporte === 'function') {
                aplicarFiltrosSoporte();
              }
            }
          } else {
            if (mensajeGuardadoError) {
              mensajeGuardadoError.textContent = data.error || 'Ocurrió un error al guardar.';
              mensajeGuardadoError.classList.remove('d-none');
            }
          }
        })
        .catch(function(err) {
          btnGuardarTecnico.disabled = false;
          if (mensajeGuardadoError) {
            mensajeGuardadoError.textContent = 'Error de conexión: ' + err.message;
            mensajeGuardadoError.classList.remove('d-none');
          }
        });
      });
    }

    // Consultar Guía IA
    if (btnConsultarIa) {
      btnConsultarIa.addEventListener('click', function() {
        if (!currentTicketId) return;

        btnConsultarIa.disabled = true;
        if (iaCargando) iaCargando.classList.remove('d-none');

        fetch('/soporte-ti/api/tickets/' + currentTicketId + '/guia-ia', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          btnConsultarIa.disabled = false;
          if (iaCargando) iaCargando.classList.add('d-none');
          if (data.success && data.guia) {
            renderizarGuia(data.guia);
          } else {
            alert('No fue posible generar la guía de IA: ' + (data.error || 'Error desconocido'));
          }
        })
        .catch(function(err) {
          btnConsultarIa.disabled = false;
          if (iaCargando) iaCargando.classList.add('d-none');
          alert('Error de conexión al consultar guía de IA: ' + err.message);
        });
      });
    }

    // Aplicar datos sugeridos de la IA a los selects
    if (btnAplicarIa) {
      btnAplicarIa.addEventListener('click', function() {
        if (!currentGuiaIa) return;

        // 1. Criticidad
        if (currentGuiaIa.criticidad_sugerida && tecnicoCriticidad) {
          const sug = currentGuiaIa.criticidad_sugerida.toLowerCase();
          Array.from(tecnicoCriticidad.options).forEach(function(opt) {
            const optVal = opt.value.toLowerCase();
            if (optVal === sug || (sug.includes('crit') && optVal.includes('crit'))) {
              opt.selected = true;
            }
          });
        }

        // 2. Área asignada
        if (currentGuiaIa.area_sugerida && tecnicoArea) {
          const sugArea = currentGuiaIa.area_sugerida.toLowerCase();
          let matched = false;
          Array.from(tecnicoArea.options).forEach(function(opt) {
            const optArea = opt.value.toLowerCase();
            if (sugArea.includes(optArea) || optArea.includes(sugArea)) {
              opt.selected = true;
              matched = true;
            }
          });
          if (!matched) {
            tecnicoArea.value = 'Soporte TI';
          }
        }

        // 3. ¿Es incidente?
        if (tecnicoIncidente && currentGuiaIa.es_incidente_sugerido !== undefined) {
          tecnicoIncidente.value = currentGuiaIa.es_incidente_sugerido ? 'Sí' : 'No';
        }

        if (mensajeAplicadoIa) {
          mensajeAplicadoIa.classList.remove('d-none');
          setTimeout(function() {
            mensajeAplicadoIa.classList.add('d-none');
          }, 3500);
        }
      });
    }

    // ==========================================
    // 4) Filtros Reactivos de Tickets (Cliente)
    // ==========================================
    const filtroBusqueda = document.getElementById('filtro-soporte-busqueda');
    const btnLimpiarBusqueda = document.getElementById('btn-limpiar-busqueda-soporte');
    const filtroEstado = document.getElementById('filtro-soporte-estado');
    const filtroFecha = document.getElementById('filtro-soporte-fecha');
    const ticketsCountBadge = document.getElementById('tickets-count-badge');
    const ticketsNoResults = document.getElementById('tickets-no-results');
    const ticketItems = document.querySelectorAll('.item-ticket');
    const totalTickets = ticketItems.length;

    function cumpleFiltroEstado(estadoStr, filtro) {
      if (!filtro || filtro === 'todos') return true;
      const est = (estadoStr || '').toLowerCase().trim();
      if (filtro === 'abierto') {
        return est === 'abierto';
      }
      if (filtro === 'en_proceso') {
        return est === 'en proceso' || est === 'en progreso' || est.includes('proceso');
      }
      if (filtro === 'cerrado_resuelto') {
        return est === 'resuelto' || est === 'cerrado' || est.includes('resuelto') || est.includes('cerrad');
      }
      return true;
    }

    function cumpleFiltroFecha(fechaStr, filtro) {
      if (!filtro || filtro === 'todas') return true;
      if (!fechaStr) return false;

      const ticketDate = new Date(fechaStr);
      if (isNaN(ticketDate.getTime())) return false;

      const now = new Date();

      if (filtro === 'hoy') {
        return ticketDate.getFullYear() === now.getFullYear() &&
               ticketDate.getMonth() === now.getMonth() &&
               ticketDate.getDate() === now.getDate();
      }

      if (filtro === 'esta_semana') {
        const day = now.getDay();
        const diffToMonday = (day === 0 ? -6 : 1) - day;
        const startOfWeek = new Date(now.getFullYear(), now.getMonth(), now.getDate() + diffToMonday, 0, 0, 0, 0);
        const hace7Dias = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
        return ticketDate >= startOfWeek || ticketDate >= hace7Dias;
      }

      if (filtro === 'ultimo_mes') {
        const unMesAtras = new Date(now.getFullYear(), now.getMonth() - 1, now.getDate(), 0, 0, 0, 0);
        return ticketDate >= unMesAtras;
      }

      return true;
    }

    function aplicarFiltrosSoporte() {
      const q = filtroBusqueda ? filtroBusqueda.value.trim().toLowerCase() : '';
      const est = filtroEstado ? filtroEstado.value : 'todos';
      const fec = filtroFecha ? filtroFecha.value : 'todas';

      if (btnLimpiarBusqueda) {
        if (q.length > 0) {
          btnLimpiarBusqueda.classList.remove('d-none');
        } else {
          btnLimpiarBusqueda.classList.add('d-none');
        }
      }

      let visibles = 0;

      ticketItems.forEach(function(item) {
        const itemNumero = item.getAttribute('data-numero') || '';
        const itemTitulo = item.getAttribute('data-titulo') || '';
        const itemEstado = item.getAttribute('data-estado') || '';
        const itemFecha = item.getAttribute('data-fecha') || '';

        const coincideTexto = !q || itemNumero.includes(q) || itemTitulo.includes(q);
        const coincideEstado = cumpleFiltroEstado(itemEstado, est);
        const coincideFecha = cumpleFiltroFecha(itemFecha, fec);

        if (coincideTexto && coincideEstado && coincideFecha) {
          item.classList.remove('d-none');
          visibles++;
        } else {
          item.classList.add('d-none');
        }
      });

      if (ticketsCountBadge) {
        if (visibles === totalTickets) {
          ticketsCountBadge.textContent = 'Total: ' + totalTickets;
        } else {
          ticketsCountBadge.textContent = visibles + ' de ' + totalTickets;
        }
      }

      if (ticketsNoResults) {
        if (visibles === 0 && totalTickets > 0) {
          ticketsNoResults.classList.remove('d-none');
        } else {
          ticketsNoResults.classList.add('d-none');
        }
      }
    }

    if (filtroBusqueda) {
      filtroBusqueda.addEventListener('input', aplicarFiltrosSoporte);
    }
    if (btnLimpiarBusqueda) {
      btnLimpiarBusqueda.addEventListener('click', function() {
        filtroBusqueda.value = '';
        btnLimpiarBusqueda.classList.add('d-none');
        aplicarFiltrosSoporte();
        filtroBusqueda.focus();
      });
    }
    if (filtroEstado) {
      filtroEstado.addEventListener('change', aplicarFiltrosSoporte);
    }
    if (filtroFecha) {
      filtroFecha.addEventListener('change', aplicarFiltrosSoporte);
    }

  })();
</script>

